# Deterministic, non-production values used only by standalone integration tests.
MYAPP_AI_IMAGE=myapp-ai
MYAPP_AI_TAG=integration
MYAPP_AI_ORCHESTRATOR_PORT=4010

MYAPP_AI_SERVICE_TOKEN=0123456789abcdef0123456789abcdef
MYAPP_AI_LITELLM_BASE_URL=http://mock-provider:4020
MYAPP_AI_LITELLM_API_KEY=integration-test-key
MYAPP_AI_MODEL=synthetic-chat
MYAPP_AI_REASONING_EFFORT=none
MYAPP_AI_EMBEDDING_MODEL=synthetic-embedding

MYAPP_AI_FRAPPE_BASE_URL=http://mock-provider:4020
MYAPP_AI_FRAPPE_SITE_HOST=localhost
MYAPP_AI_POLICY_CACHE_TTL_SECONDS=30

MYAPP_AI_REDIS_PASSWORD=integration-redis-password
MYAPP_AI_REDIS_URL=redis://:integration-redis-password@ai-redis:6379/0
MYAPP_AI_REDIS_KEY_PREFIX=myapp-ai:integration

MYAPP_AI_QDRANT_URL=http://ai-vector:6333
MYAPP_AI_QDRANT_COLLECTION=myapp-products-integration-v1
MYAPP_AI_QDRANT_ALIAS=myapp-products-integration-live
MYAPP_AI_VECTOR_TIMEOUT_SECONDS=15

MYAPP_AI_GOVERNANCE_LIVE_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/live-gate.json
MYAPP_AI_GOVERNANCE_EMBEDDING_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/embedding-gate.json

MYAPP_AI_LANGFUSE_HOST=
MYAPP_AI_LANGFUSE_PUBLIC_KEY=
MYAPP_AI_LANGFUSE_SECRET_KEY=
MYAPP_AI_LANGFUSE_ENVIRONMENT=test
MYAPP_AI_LANGFUSE_RELEASE=standalone-integration
MYAPP_AI_LANGFUSE_CAPTURE_CONTENT=0

MYAPP_AI_TIMEOUT_SECONDS=60
MYAPP_AI_MAX_COMPLETION_TOKENS=1200
MYAPP_AI_CHAT_CONCURRENCY=20
MYAPP_AI_STRUCTURED_CONCURRENCY=10
MYAPP_AI_EMBEDDING_CONCURRENCY=4
