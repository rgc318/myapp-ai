# Copy to .env and replace every change-me value before starting the stack.

MYAPP_AI_IMAGE=myapp-ai
MYAPP_AI_TAG=local
MYAPP_AI_ORCHESTRATOR_PORT=4010

MYAPP_AI_SERVICE_TOKEN=change-me-use-at-least-32-random-characters
MYAPP_AI_LITELLM_BASE_URL=http://host.docker.internal:4000
MYAPP_AI_LITELLM_API_KEY=change-me-litellm-key
MYAPP_AI_MODEL=erp-fast-chat
MYAPP_AI_FALLBACK_MODELS=erp-safe-fallback
MYAPP_AI_REASONING_EFFORT=none
MYAPP_AI_EMBEDDING_MODEL=erp-embedding

MYAPP_AI_FRAPPE_BASE_URL=http://host.docker.internal:8000
MYAPP_AI_FRAPPE_SITE_HOST=localhost
MYAPP_AI_POLICY_CACHE_TTL_SECONDS=30

MYAPP_AI_REDIS_PASSWORD=change-me-redis-password
MYAPP_AI_REDIS_URL=redis://:change-me-redis-password@ai-redis:6379/0
MYAPP_AI_REDIS_KEY_PREFIX=myapp-ai:standalone

MYAPP_AI_QDRANT_URL=http://ai-vector:6333
MYAPP_AI_QDRANT_COLLECTION=myapp-products-v1
MYAPP_AI_QDRANT_ALIAS=myapp-products-live
MYAPP_AI_VECTOR_TIMEOUT_SECONDS=15

MYAPP_AI_RUNTIME_REVISION=standalone-local
MYAPP_AI_GOVERNANCE_OFFLINE_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/offline-gate.json
MYAPP_AI_GOVERNANCE_LIVE_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/live-gate.json
MYAPP_AI_GOVERNANCE_EMBEDDING_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/embedding-gate.json

MYAPP_AI_LANGFUSE_HOST=
MYAPP_AI_LANGFUSE_PUBLIC_KEY=
MYAPP_AI_LANGFUSE_SECRET_KEY=
MYAPP_AI_LANGFUSE_ENVIRONMENT=development
MYAPP_AI_LANGFUSE_RELEASE=standalone-local
MYAPP_AI_LANGFUSE_CAPTURE_CONTENT=0

MYAPP_AI_TIMEOUT_SECONDS=60
MYAPP_AI_PROVIDER_MAX_ATTEMPTS=3
MYAPP_AI_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
MYAPP_AI_MAX_COMPLETION_TOKENS=1200
MYAPP_AI_CHAT_CONCURRENCY=100
MYAPP_AI_STRUCTURED_CONCURRENCY=20
MYAPP_AI_EMBEDDING_CONCURRENCY=8
